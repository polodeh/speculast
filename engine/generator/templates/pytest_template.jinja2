def _module_objects(module_name: str) -> dict[str, object]:
    imported_module = importlib.import_module(module_name)
    object_names = MODULE_IMPORTS.get(module_name, [])
    return {
        object_name: getattr(imported_module, object_name)
        for object_name in object_names
        if hasattr(imported_module, object_name)
    }


def _annotation_symbol(annotation: str) -> str | None:
    normalized = annotation.strip()
    if not normalized:
        return None

    base = normalized.split("[", maxsplit=1)[0]
    base = base.split("|", maxsplit=1)[0].strip()
    symbol = base.rsplit(".", maxsplit=1)[-1].strip()
    if not symbol or not symbol[0].isalpha():
        return None
    return symbol


def _resolve_project_symbol(symbol_name: str) -> object | None:
    for module_name, object_names in MODULE_IMPORTS.items():
        if symbol_name not in object_names:
            continue
        module_objects = _module_objects(module_name)
        if symbol_name in module_objects:
            return module_objects[symbol_name]
    return None


