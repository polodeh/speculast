    return None


def _resolve_metadata(module: object) -> object:
    base_candidate = getattr(module, "Base", None)
    metadata = getattr(base_candidate, "metadata", None)
    if metadata is not None and hasattr(metadata, "create_all"):
        return metadata

    for attribute_name in dir(module):
        candidate = getattr(module, attribute_name)
        metadata = getattr(candidate, "metadata", None)
        if metadata is not None and hasattr(metadata, "create_all"):
            return metadata

    return GeneratedIntegrationBase.metadata


