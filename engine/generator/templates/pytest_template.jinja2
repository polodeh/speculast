def _prepare_call_arguments(
    case: dict[str, Any],
    *,
    tmp_path: Path,
{% if use_real_db and has_db_bound_functions %}
    db_session: AsyncSession | None = None,
    db_engine: AsyncEngine | None = None,
{% endif %}
) -> tuple[list[object], dict[str, object]]:
    positional_args: list[object] = []
    keyword_args: dict[str, object] = {}

    for argument in case["arguments"]:
        name = str(argument["name"])
        if case["class_name"] and name in {"self", "cls"}:
            continue
        if not bool(argument["required"]) and argument["default_value"] is not None:
            continue
        if str(argument["kind"]) in {"var_positional", "var_keyword"}:
            continue

        value = _synthesize_value(
            argument,
            case=case,
            tmp_path=tmp_path,
{% if use_real_db and has_db_bound_functions %}
            db_session=db_session,
            db_engine=db_engine,
{% endif %}
        )
        if value is _UNSUPPORTED:
            pytest.skip(f"Не удалось синтезировать аргумент {name} для {case['qualname']}.")

        if str(argument["kind"]) == "keyword_only":
            keyword_args[name] = value
        else:
            positional_args.append(value)

    return positional_args, keyword_args


def _build_mock_return(case: dict[str, Any]) -> object:
    annotation = _annotation_text(case.get("return_annotation"))
    if not annotation or annotation == "none":
        return None
    if "bool" in annotation:
        return True
    if "int" in annotation:
        return 1
    if "float" in annotation:
        return 0.25
    if "str" in annotation:
        return "generated"
    if "list" in annotation or "sequence" in annotation:
        return ["generated"]
    if "dict" in annotation or "mapping" in annotation:
        return {"generated": True}
    if "path" in annotation:
        return Path("generated.txt")
    return None


def _build_http_mock_response() -> _GeneratedHttpResponse:
    return _GeneratedHttpResponse()


def _build_mock_replacement(target_name: str, case: dict[str, Any]) -> object:
    if target_name in HTTP_MOCK_TARGETS:
        return MagicMock(return_value=_build_http_mock_response())
    if bool(case["requires_async_test"]):
        return AsyncMock(return_value=_build_mock_return(case))
    return MagicMock(return_value=_build_mock_return(case))


def _patch_mock_targets(
    monkeypatch: pytest.MonkeyPatch,
    case: dict[str, Any],
) -> dict[str, object]:
    patched: dict[str, object] = {}
    for target_name in case["mock_targets"]:
        root_name = _root_token(str(target_name))
        try:
            parent = importlib.import_module(root_name)
        except ImportError:
            continue

        parts = str(target_name).split(".")[1:]
        if not parts:
            continue

        try:
            for part in parts[:-1]:
                parent = getattr(parent, part)
        except AttributeError:
            continue

        replacement = _build_mock_replacement(str(target_name), case)
        monkeypatch.setattr(parent, parts[-1], replacement, raising=False)
        patched[str(target_name)] = replacement
    return patched


def _assert_result_shape(result: object, case: dict[str, Any]) -> None:
    annotation = _annotation_text(case.get("return_annotation"))
    if not annotation:
