def _annotation_text(annotation: object) -> str:
    return str(annotation or "").strip().lower()


def _root_token(value: str) -> str:
    return value.split(".", maxsplit=1)[0].strip()


def _instantiate_class(
    class_obj: type[Any],
    *,
    tmp_path: Path,
) -> object:
    if getattr(class_obj, "_is_protocol", False):
        pytest.skip("Protocol-классы не создаются автоматически.")

    try:
        signature = inspect.signature(class_obj)
    except (TypeError, ValueError):
        return class_obj()

    required_parameters = [
        parameter
        for parameter in signature.parameters.values()
        if parameter.default is inspect.Signature.empty
        and parameter.kind not in {inspect.Parameter.VAR_POSITIONAL, inspect.Parameter.VAR_KEYWORD}
    ]
    if required_parameters:
        pytest.skip(f"Невозможно автоматически создать экземпляр {class_obj.__name__}.")
    return class_obj()


def _resolve_target(
    case: dict[str, Any],
    *,
    tmp_path: Path,
) -> object:
    module_objects = _module_objects(str(case["module"]))
    class_name = case["class_name"]
    if class_name:
        class_obj = _resolve_owner_object(case, module_objects)
        instance = _instantiate_class(class_obj, tmp_path=tmp_path)
        return getattr(instance, str(case["name"]))
    target = module_objects.get(str(case["name"]))
    if target is not None:
        return target
    imported_module = importlib.import_module(str(case["module"]))
    return getattr(imported_module, str(case["name"]))


def _resolve_owner_object(case: dict[str, Any], module_objects: dict[str, object]) -> type[Any]:
    class_path = str(case["qualname"]).split(".")[:-1]
    if not class_path:
        raise AttributeError(f"Unable to resolve owning class for {case['qualname']}.")

    imported_module = importlib.import_module(str(case["module"]))
    current: object | None = module_objects.get(class_path[0])
    if current is None:
        current = getattr(imported_module, class_path[0])
    for part in class_path[1:]:
        current = getattr(current, part)
    if not inspect.isclass(current):
        raise TypeError(f"Resolved owner for {case['qualname']} is not a class.")
    return current


def _uses_json_load(case: dict[str, Any]) -> bool:
    return any("json.load" in str(call_name) for call_name in case["external_calls"])


def _expects_json_file(case: dict[str, Any], argument: dict[str, Any]) -> bool:
    name = str(argument["name"]).lower()
    if _uses_json_load(case) and ("path" in name or "file" in name):
        return True
    return name in {
        "config_path",
        "config_file",
        "settings_path",
        "settings_file",
        "schema_path",
        "schema_file",
    }


def _build_json_file(tmp_path: Path, argument: dict[str, Any]) -> Path:
    name = str(argument["name"]).lower()
    payload: object = (
        []
        if any(token in name for token in {"items", "entries", "records", "rows", "values", "list"})
        else {}
    )
    candidate = (tmp_path / f"{name or 'config'}.json").resolve()
    candidate.write_text(json.dumps(payload), encoding="utf-8")
    return candidate


